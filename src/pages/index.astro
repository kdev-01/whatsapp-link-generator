---
import "../styles/global.css";
import { PAGE_META } from "../data/meta";
import AppCard from "../components/AppCard.astro";
import WhatsAppForm from "../components/WhatsAppForm.astro";
import FAQ from "../components/FAQ.astro";
---

<html lang="en">
	<head>
		<script
			data-cfasync="false"
			src="https://cmp.gatekeeperconsent.com/min.js"></script>
		<script
			data-cfasync="false"
			src="https://the.gatekeeperconsent.com/cmp.min.js"></script>
		<script async src="https://www.ezojs.com/ezoic/sa.min.js"></script>
		<script>
			const ezoicWindow = window as Window & {
				ezstandalone?: { cmd?: unknown[] };
			};
			ezoicWindow.ezstandalone = ezoicWindow.ezstandalone || {};
			ezoicWindow.ezstandalone.cmd = ezoicWindow.ezstandalone.cmd || [];
		</script>
		<script src="https://ezoicanalytics.com/analytics.js"></script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{PAGE_META.title}</title>
		<meta name="description" content={PAGE_META.description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={PAGE_META.title} />
		<meta property="og:description" content={PAGE_META.description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-adsense-account" content="ca-pub-8965147437983317" />
	</head>
	<body>
		<main class="page-main">
			<div class="page-content">
				<AppCard>
					<WhatsAppForm />
					<FAQ />
				</AppCard>
			</div>
			<footer class="app-footer">
				<span data-i18n-key="footer_note">
					Made to help you send quick WhatsApp messages without
					filling your contacts list.
				</span>
			</footer>
		</main>
		<script>
			import "../scripts/whatsapp-form";
		</script>
	</body>
</html>
